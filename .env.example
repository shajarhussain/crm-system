# Copy to .env.local (git-ignored). Public Firebase web config only — never put secrets here.
# Get these via: firebase apps:sdkconfig web  (or the Firebase console → Project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Everything below is NOT public. Set these in Vercel Environment Variables
#     (for the Next.js app) or via `firebase functions:secrets:set` (for Cloud Functions).
#     Never fill real values into this file or commit them.

# Only needed if the Next.js app makes server-side Admin SDK calls:
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Meta Lead Ads webhook verification (Cloud Functions secret, not here):
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=

# Reserved — leave unset until the client provides WhatsApp Business API credentials.
# See docs/integrations/whatsapp-placeholder.md
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Vercel MCP (local dev / agent use only — generate at vercel.com/account/tokens)
# VERCEL_TOKEN=

# GitHub MCP (personal access token, repo + read:org + read:user scopes)
# GITHUB_TOKEN=
