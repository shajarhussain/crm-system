rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }
    function isEmployee() {
      return isAuthenticated() && request.auth.token.role == 'employee';
    }
    
    match /users/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow write: if false; // Writes go through Callable Functions
    }
    
    match /campaigns/{campaignId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /leads/{leadId} {
      allow read: if isAdmin() || (isEmployee() && resource.data.assignedUserId == request.auth.uid);
      allow write: if false; // Writes go through Callable Functions
      
      match /followUps/{followUpId} {
        allow read: if isAdmin() || (isEmployee() && get(/databases/$(database)/documents/leads/$(leadId)).data.assignedUserId == request.auth.uid);
        allow write: if false; // Immutable, created via Callable Function
      }
      
      match /events/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }
    
    match /closedDeals/{dealId} {
      allow read: if isAdmin() || (isEmployee() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    
    match /expenses/{expenseId} {
      allow read: if isAdmin();
      allow write: if false; 
    }
    
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (isEmployee() && resource.data.targetUid == request.auth.uid);
      allow write: if false;
    }
    
    match /config/{configId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
