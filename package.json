{
  "name": "crm-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/distribution.test.ts src/lib/money.test.ts",
    "check": "npm run typecheck && npm run test && npm run lint",
    "check-auth": "node --env-file=.env.local --experimental-strip-types scripts/check-auth.mts",
    "set-admin-role": "node --env-file=.env.local --experimental-strip-types scripts/set-admin-role.mts",
    "purge-demo-data": "node --env-file=.env.local --experimental-strip-types scripts/purge-demo-data.mts",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
